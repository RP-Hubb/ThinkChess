{
  "name": "thinkchess",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm --workspace=apps/web run dev",
    "dev:all": "concurrently \"npm --workspace=apps/api run dev\" \"npm --workspace=apps/web run dev\"",
    "dev:web": "npm --workspace=apps/web run dev",
    "dev:api": "npm --workspace=apps/api run dev",
    "build": "npm --workspace=packages/chess-core run build && npm --workspace=apps/api run build && npm --workspace=apps/web run build",
    "test": "npm --workspaces run test"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
