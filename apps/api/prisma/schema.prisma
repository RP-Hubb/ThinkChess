datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  name            String?
  imageUrl        String?
  authProvider    String           @default("email")
  passwordHash    String?
  estimatedRating Int              @default(800)
  ratingBand      String           @default("0-800")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  preferences      UserPreference?
  games            Game[]
  thinkingProfile  ThinkingProfile?
  trainingSessions TrainingSession[]
  repertoires      OpeningRepertoire[]

  @@index([email])
}

model UserPreference {
  id                String   @id @default(cuid())
  userId            String   @unique
  coachVerbosity    String   @default("standard")
  coachFrequency    String   @default("critical_moments")
  blunderPrevention Boolean  @default(true)
  boardTheme        String   @default("dark_slate")
  pieceTheme        String   @default("neo")
  soundEnabled      Boolean  @default(true)
  whiteHintsEnabled Boolean  @default(true)
  blackHintsEnabled Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Game {
  id            String    @id @default(cuid())
  userId        String
  mode          String    @default("play_vs_bot")
  result        String?
  userColor     String    @default("white")
  botId         String?
  botDifficulty String?
  initialFen    String    @default("rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1")
  finalFen      String?
  pgn           String?   @db.Text
  moveCount     Int       @default(0)
  accuracyWhite Float?
  accuracyBlack Float?
  status        String    @default("in_progress")
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  moves           Move[]
  analysis        GameAnalysis?
  criticalMoments CriticalMoment[]
  puzzles         Puzzle[]

  @@index([userId, status])
  @@index([createdAt])
}

model Move {
  id             String   @id @default(cuid())
  gameId         String
  moveNumber     Int
  ply            Int
  color          String
  san            String
  uci            String
  fenBefore      String
  fenAfter       String
  evalBeforeCp   Int?
  evalAfterCp    Int?
  evalBeforeMate Int?
  evalAfterMate  Int?
  classification String?
  timeSpentMs    Int?
  createdAt      DateTime @default(now())

  game          Game           @relation(fields: [gameId], references: [id], onDelete: Cascade)
  engineLines   EngineLine[]
  coachMessages CoachMessage[]

  @@index([gameId, ply])
  @@index([classification])
}

model EngineLine {
  id            String   @id @default(cuid())
  moveId        String?
  fen           String
  depth         Int
  multipv       Int
  scoreCp       Int?
  scoreMate     Int?
  lineUci       String   @db.Text
  lineSan       String?  @db.Text
  engineVersion String   @default("Stockfish 16 WASM")
  createdAt     DateTime @default(now())

  move Move? @relation(fields: [moveId], references: [id], onDelete: Cascade)

  @@index([fen])
  @@index([moveId])
}

model CoachMessage {
  id            String   @id @default(cuid())
  moveId        String?
  userId        String
  fen           String
  type          String
  promptVersion String   @default("v1.0")
  content       Json
  createdAt     DateTime @default(now())

  move Move? @relation(fields: [moveId], references: [id], onDelete: Cascade)

  @@index([moveId])
  @@index([userId, type])
}

model GameAnalysis {
  id              String   @id @default(cuid())
  gameId          String   @unique
  summary         Json
  recommendations Json
  analyzedAt      DateTime @default(now())

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
}

model CriticalMoment {
  id            String    @id @default(cuid())
  gameId        String
  moveId        String?
  type          String
  severity      String
  fen           String
  engineSummary Json
  userThought   String?   @db.Text
  aiReview      Json?
  thinkingTags  String[]
  reviewedAt    DateTime?
  createdAt     DateTime  @default(now())

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId])
  @@index([type])
}

model ThinkingProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  strengths         Json
  weaknesses        Json
  patternStats      Json
  currentPriorities Json
  gamesAnalyzed     Int      @default(0)
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Puzzle {
  id           String   @id @default(cuid())
  userId       String?
  sourceGameId String?
  sourceMoveId String?
  fen          String
  solutionUci  String[]
  solutionSan  String[]
  theme        String
  difficulty   Int      @default(1000)
  explanation  Json?
  createdAt    DateTime @default(now())

  sourceGame Game?           @relation(fields: [sourceGameId], references: [id], onDelete: SetNull)
  attempts   PuzzleAttempt[]

  @@index([userId])
  @@index([theme])
}

model PuzzleAttempt {
  id          String   @id @default(cuid())
  puzzleId    String
  userId      String
  solved      Boolean
  movesPlayed String[]
  timeMs      Int?
  createdAt   DateTime @default(now())

  puzzle Puzzle @relation(fields: [puzzleId], references: [id], onDelete: Cascade)

  @@index([userId, solved])
}

model TrainingSession {
  id          String    @id @default(cuid())
  userId      String
  type        String
  summary     Json?
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CandidateMoveAttempt {
  id             String   @id @default(cuid())
  userId         String
  gameId         String?
  fen            String
  candidatesUci  String[]
  finalMoveUci   String?
  engineTopMoves Json
  score          Float
  feedback       Json
  createdAt      DateTime @default(now())

  @@index([userId])
}

model CalculationAttempt {
  id              String   @id @default(cuid())
  userId          String
  fen             String
  targetDepth     Int
  userLineUci     String[]
  engineLineUci   String[]
  firstDivergence Int?
  score           Float
  feedback        Json
  createdAt       DateTime @default(now())

  @@index([userId])
}

model OpeningRepertoire {
  id        String        @id @default(cuid())
  userId    String
  name      String
  color     String
  lines     OpeningLine[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OpeningLine {
  id           String            @id @default(cuid())
  repertoireId String
  eco          String?
  name         String?
  movesUci     String[]
  movesSan     String[]
  ideas        Json?

  repertoire OpeningRepertoire @relation(fields: [repertoireId], references: [id], onDelete: Cascade)
}

model OpeningMemoryItem {
  id              String    @id @default(cuid())
  userId          String
  fen             String
  expectedMoveUci String
  status          String    @default("new")
  easeFactor      Float     @default(2.5)
  intervalDays    Int       @default(0)
  dueAt           DateTime  @default(now())
  lastReviewedAt  DateTime?

  @@index([userId, dueAt])
}

